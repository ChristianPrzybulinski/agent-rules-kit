{
  "_format": "cases[]: name (str), dirs (folders created under a throwaway HOME), links (symlink -> target, both under HOME), files (path -> text; @HOME@ becomes the HOME path), xattr (folder -> com.apple.file-provider-domain-id value, answered by a stub xattr; macOS only), env (variable -> folder under HOME), cwd (payload cwd under HOME) or stdin (raw payload), warn (true: a systemMessage naming the cloud-synced folder, given only when the folder holds the root of the repository around cwd, the nearest folder with a .git entry; false: empty stdout); every case exits 0",
  "cases": [
    {
      "name": "unsynced folder",
      "dirs": [
        "Developer/repo/.git"
      ],
      "cwd": "Developer/repo",
      "warn": false
    },
    {
      "name": "iCloud Drive",
      "dirs": [
        "Library/Mobile Documents/com~apple~CloudDocs/repo/.git"
      ],
      "cwd": "Library/Mobile Documents/com~apple~CloudDocs/repo",
      "warn": true
    },
    {
      "name": "File Provider client",
      "dirs": [
        "Library/CloudStorage/Dropbox/repo/.git"
      ],
      "cwd": "Library/CloudStorage/Dropbox/repo",
      "warn": true
    },
    {
      "name": "symlink into a synced folder",
      "dirs": [
        "Library/CloudStorage/GoogleDrive-x/repo/.git"
      ],
      "links": {
        "Developer/repo": "Library/CloudStorage/GoogleDrive-x/repo"
      },
      "cwd": "Developer/repo",
      "warn": true
    },
    {
      "name": "Documents without the iCloud attribute",
      "dirs": [
        "Documents/repo/.git"
      ],
      "cwd": "Documents/repo",
      "warn": false
    },
    {
      "name": "iCloud Documents",
      "dirs": [
        "Documents/repo/.git"
      ],
      "xattr": {
        "Documents": "com.apple.CloudDocs.iCloudDriveFileProvider/00000000-0000-0000-0000-000000000000"
      },
      "cwd": "Documents/repo",
      "warn": true
    },
    {
      "name": "iCloud Desktop",
      "dirs": [
        "Desktop/repo/.git"
      ],
      "xattr": {
        "Desktop": "com.apple.CloudDocs.iCloudDriveFileProvider/00000000-0000-0000-0000-000000000000"
      },
      "cwd": "Desktop/repo",
      "warn": true
    },
    {
      "name": "iCloud Documents symlink to an unsynced folder",
      "dirs": [
        "Developer/GitHub/repo/.git",
        "Documents"
      ],
      "xattr": {
        "Documents": "com.apple.CloudDocs.iCloudDriveFileProvider/00000000-0000-0000-0000-000000000000"
      },
      "links": {
        "Documents/GitHub": "Developer/GitHub"
      },
      "cwd": "Documents/GitHub/repo",
      "warn": false
    },
    {
      "name": "OneDrive variable",
      "dirs": [
        "OneDrive - Org/repo/.git"
      ],
      "env": {
        "OneDriveCommercial": "OneDrive - Org"
      },
      "cwd": "OneDrive - Org/repo",
      "warn": true
    },
    {
      "name": "OneDrive name prefix only",
      "dirs": [
        "OneDrive",
        "OneDrive2/repo/.git"
      ],
      "env": {
        "OneDrive": "OneDrive"
      },
      "cwd": "OneDrive2/repo",
      "warn": false
    },
    {
      "name": "Dropbox info.json",
      "dirs": [
        "Dropbox (Personal)/repo/.git"
      ],
      "files": {
        ".dropbox/info.json": "{\"personal\": {\"path\": \"@HOME@/Dropbox (Personal)\"}}"
      },
      "cwd": "Dropbox (Personal)/repo",
      "warn": true
    },
    {
      "name": "corrupt Dropbox info.json",
      "dirs": [
        "Developer/repo/.git"
      ],
      "files": {
        ".dropbox/info.json": "not json"
      },
      "cwd": "Developer/repo",
      "warn": false
    },
    {
      "name": "iCloud Drive folder that is not a repository",
      "dirs": [
        "Library/Mobile Documents/com~apple~CloudDocs/notes"
      ],
      "cwd": "Library/Mobile Documents/com~apple~CloudDocs/notes",
      "warn": false
    },
    {
      "name": "subfolder of a repository in iCloud Drive",
      "dirs": [
        "Library/Mobile Documents/com~apple~CloudDocs/repo/.git",
        "Library/Mobile Documents/com~apple~CloudDocs/repo/src"
      ],
      "cwd": "Library/Mobile Documents/com~apple~CloudDocs/repo/src",
      "warn": true
    },
    {
      "name": "worktree in iCloud Drive (.git file)",
      "files": {
        "Library/Mobile Documents/com~apple~CloudDocs/wt/.git": "gitdir: @HOME@/Developer/repo/.git/worktrees/wt\n"
      },
      "cwd": "Library/Mobile Documents/com~apple~CloudDocs/wt",
      "warn": true
    },
    {
      "name": "repository root above the synced folder",
      "dirs": [
        ".git",
        "Library/CloudStorage/Dropbox/notes"
      ],
      "cwd": "Library/CloudStorage/Dropbox/notes",
      "warn": false
    },
    {
      "name": "payload that is not JSON",
      "stdin": "not json",
      "warn": false
    }
  ]
}
