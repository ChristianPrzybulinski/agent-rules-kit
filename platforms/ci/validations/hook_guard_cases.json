  "allowed": [
    "grep -rn \"rm -rf\" docs",
    "git push origin feature/x",
    "rm file.txt",
    "rm -r build",
    "git log --oneline -5",
    "git reset HEAD~1",
    "git clean -n",
    "echo 'DROP TABLE' > notes.md",
    "git push --force-if-includes",
    "rmdir x",
    "git diff --stat",
    "git commit -m 'remove rm -rf from script'",
