{
  "blocked": [
    "rm -rf /tmp/x",
    "sudo rm -rf /var/lib/x",
    "cd build && rm -fr dist",
    "find . -name '*.o' | xargs rm -rf",
    "git push --force origin main",
    "git push -f",
    "git push origin feat --force-with-lease",
    "git push --force-with-lease=main origin feat",
    "git reset --hard HEAD~1",
    "git clean -fd",
    "psql -d app -c \"DROP TABLE users\"",
    "mysql app -e 'truncate t'",
    "echo x; rm -Rf y"
