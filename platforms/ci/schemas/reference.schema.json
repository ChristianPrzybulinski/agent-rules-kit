{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ChristianPrzybulinski/agent-rules-kit/platforms/ci/schemas/reference.schema.json",
  "title": "Frontmatter of own skill references",
  "type": "object",
  "required": ["description", "kind"],
  "additionalProperties": false,
  "properties": {
    "description": { "type": "string", "maxLength": 160 },
    "kind": { "type": "string", "enum": ["fact", "detail"] },
    "verified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^https?://" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "fact" } }, "required": ["kind"] },
      "then": { "required": ["verified", "sources"] }
    }
  ]
}
