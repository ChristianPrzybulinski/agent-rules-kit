{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ChristianPrzybulinski/agent-rules-kit/platforms/ci/schemas/skills-lock.schema.json",
  "title": "Line of platforms/kits/third-party/skills.lock (converted to an object by the validator)",
  "type": "object",
  "required": ["name", "plugin", "repo", "path", "sha", "license", "verified"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,40}$" },
    "plugin": { "type": "string", "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$" },
    "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "path": { "type": "string", "pattern": "^[A-Za-z0-9_./-]+$" },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "license": { "type": "string", "minLength": 3 },
    "verified": { "type": "string", "format": "date" }
  }
}
