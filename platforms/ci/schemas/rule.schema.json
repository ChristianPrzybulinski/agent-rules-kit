{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ChristianPrzybulinski/agent-rules-kit/platforms/ci/schemas/rule.schema.json",
  "title": "Frontmatter of agents/rules/**/*.md",
  "type": "object",
  "required": ["description", "trigger"],
  "additionalProperties": false,
  "properties": {
    "description": {
      "type": "string",
      "minLength": 40,
      "maxLength": 400,
      "description": "What the rule covers and WHEN to load it. Must contain the word 'Load' or 'Use'."
    },
    "trigger": { "type": "string", "enum": ["always_on", "model_decision", "glob"] },
    "globs": {
      "type": "array",
      "items": { "type": "string", "minLength": 2 },
      "minItems": 1,
      "description": "Required when trigger = glob."
    }
  },
  "if": { "properties": { "trigger": { "const": "glob" } } },
  "then": { "required": ["globs"] }
}
