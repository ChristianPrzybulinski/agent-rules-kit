{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ChristianPrzybulinski/agent-rules-kit/platforms/ci/schemas/rule.schema.json",
  "title": "Frontmatter of plugins/*/rules/*.md",
  "type": "object",
  "required": [
    "description",
    "trigger"
  ],
  "additionalProperties": false,
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 160
    },
    "trigger": {
      "type": "string",
      "enum": [
        "glob",
        "model_decision",
        "manual"
      ]
    },
    "globs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
