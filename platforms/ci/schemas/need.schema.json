{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ChristianPrzybulinski/agent-rules-kit/schemas/need.schema.json",
  "title": "Frontmatter of NEED-nnn",
  "type": "object",
  "required": ["id", "title", "type", "status", "origin", "created"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^NEED-[0-9]{3,}$" },
    "title": { "type": "string", "minLength": 5, "maxLength": 120 },
    "type": { "type": "string", "enum": ["new", "improvement", "fix", "content", "platform", "decision"] },
    "status": {
      "type": "string",
      "enum": ["proposed", "triaged", "specified", "refined", "delivered", "rejected", "merged", "routed", "parked"]
    },
    "origin": { "type": "string", "minLength": 3 },
    "parent": { "type": ["string", "null"], "pattern": "^NEED-[0-9]{3,}$" },
    "requirements": {
      "type": "array",
      "items": { "type": "string", "pattern": "^REQ-(F|NF)-[0-9]{3,}$" },
      "uniqueItems": true
    },
    "journeys": {
      "type": "array",
      "items": { "type": "string", "pattern": "^J-[0-9]{2,}$" },
      "uniqueItems": true
    },
    "processes": {
      "type": "array",
      "items": { "type": "string", "pattern": "^PROC-[0-9]{3,}$" },
      "uniqueItems": true
    },
    "decisions": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,7}-[0-9]{3,}$" },
      "uniqueItems": true
    },
    "debts": {
      "type": "array",
      "items": { "type": "string", "pattern": "^DEBT-[0-9]{3,}$" },
      "uniqueItems": true
    },
    "features": {
      "type": "array",
      "items": { "type": "string", "pattern": "^FEAT-[0-9]{3,}$" },
      "uniqueItems": true
    },
    "created": { "type": "string", "format": "date" },
    "updated": { "type": "string", "format": "date" }
  }
}
