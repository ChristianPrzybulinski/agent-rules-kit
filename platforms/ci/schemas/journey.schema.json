{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ChristianPrzybulinski/agent-rules-kit/schemas/journey.schema.json",
  "title": "Frontmatter of J-NN (a journey)",
  "type": "object",
  "required": ["id", "title", "status", "owner", "created", "updated"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^J-[0-9]{2,}$" },
    "title": { "type": "string", "minLength": 5, "maxLength": 100 },
    "status": { "type": "string", "enum": ["proposed", "approved", "retired"] },
    "owner": { "type": "string" },
    "created": { "type": "string", "format": "date" },
    "updated": { "type": "string", "format": "date" }
  }
}
