{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ChristianPrzybulinski/agent-rules-kit/platforms/ci/schemas/skill.schema.json",
  "title": "Frontmatter of skills/<name>/SKILL.md (own skills; vendor only validates name/description)",
  "type": "object",
  "required": ["name", "version", "description", "triggers"],
  "additionalProperties": true,
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,40}$", "description": "Same as the folder name." },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "description": {
      "type": "string",
      "minLength": 40,
      "maxLength": 160,
      "description": "What it does + 'Use when…' + 'Not for…'."
    },
    "argument-hint": { "type": "string" },
    "triggers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["user", "model"] }
    },
    "allowed-tools": { "type": "array", "items": { "type": "string" } },
    "disable-model-invocation": { "type": "boolean" }
  }
}
