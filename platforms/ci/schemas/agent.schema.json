{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ChristianPrzybulinski/agent-rules-kit/platforms/ci/schemas/agent.schema.json",
  "title": "Frontmatter of plugins/*/agents/*.md",
  "type": "object",
  "required": [
    "name",
    "description",
    "allowed-tools",
    "tools"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,40}$",
      "description": "Same as the file stem."
    },
    "description": {
      "type": "string",
      "minLength": 40,
      "maxLength": 160
    },
    "model": {
      "type": "string"
    },
    "omitClaudeMd": {
      "type": "boolean"
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Claude Code subagent preload: the full text of each kit skill is injected at the subagent's start; plugin:skill, since a bare name can resolve to a bundled skill (KIT-071).",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$"
      }
    },
    "allowed-tools": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "read",
          "grep",
          "glob",
          "exec",
          "edit",
          "write"
        ]
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "Read",
          "Grep",
          "Glob",
          "Bash",
          "Edit",
          "Write"
        ]
      }
    }
  }
}
