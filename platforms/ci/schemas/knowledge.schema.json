{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ChristianPrzybulinski/agent-rules-kit/platforms/ci/schemas/knowledge.schema.json",
  "title": "Frontmatter of agents/knowledge/**/*.md",
  "type": "object",
  "required": ["description", "trigger", "verified", "sources"],
  "additionalProperties": false,
  "properties": {
    "description": {
      "type": "string",
      "minLength": 40,
      "maxLength": 400,
      "description": "Which fact/version/glossary the note contains and when to load it."
    },
    "trigger": { "type": "string", "const": "model_decision" },
    "verified": { "type": "string", "format": "date", "description": "Date the facts were checked against the source." },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^https?://" }
    },
    "expires": { "type": "string", "format": "date", "description": "Optional: when to recheck (e.g.: next LTS)." }
  }
}
