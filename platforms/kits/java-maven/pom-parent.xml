<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- The kit's parent POM. In a real project: change groupId/artifactId and use as the modules' <parent>. -->
  <groupId>kit.java.maven</groupId>
  <artifactId>parent</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Versions verified on Maven Central on 2026-10-06. The Boot BOM, Spotless, google-java-format,
         JaCoCo, PIT, pitest-junit5 and dependency-check versions match a working Boot 4.1.1 build
         (2026-10-05); the kit's newer Spotless 3.10.3 and google-java-format 1.36.1 exist on Central
         but the proven-build pins are kept. The Flyway plugin matches the flyway-core the BOM manages;
         enforcer, versions, surefire and failsafe are the kit's own pins, seen on Central. A property
         marked "verify" could not be checked against Maven Central when it was written. -->
    <spring-boot.version>4.1.1</spring-boot.version>
    <spotless.version>3.10.2</spotless.version>
    <google-java-format.version>1.30.0</google-java-format.version>
    <jacoco.version>0.8.15</jacoco.version>
    <pitest.version>1.30.0</pitest.version>
    <pitest-junit5.version>1.2.3</pitest-junit5.version>
    <dependency-check.version>13.0.0</dependency-check.version>
    <enforcer.version>3.6.3</enforcer.version>
    <versions.version>2.22.0</versions.version>
    <flyway.version>12.4.0</flyway.version>
    <surefire.version>3.6.0</surefire.version>
    <failsafe.version>3.6.0</failsafe.version>

    <!-- skips controlled by the `fast` profile -->
    <pitest.skip>false</pitest.skip>
    <dependency-check.skip>false</dependency-check.skip>
  </properties>

  <!-- Boot 4.1.1 manages tomcat-embed-core 11.0.24, which fails the dependency-check gate (CVSS >= 7, nine
       CVE-2026-* findings). A project importing this BOM overrides Tomcat with explicit tomcat-embed-* entries
       placed BEFORE the import below; a tomcat.version property only works under spring-boot-starter-parent.
       Verify against the Boot 4.1.x release notes whether a newer patch already manages >= 11.0.26. -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless.version}</version>
          <configuration>
            <java>
              <googleJavaFormat>
                <version>${google-java-format.version}</version>
              </googleJavaFormat>
            </java>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
          <executions>
            <execution>
              <id>prepare-agent</id>
              <goals><goal>prepare-agent</goal></goals>
            </execution>
            <execution>
              <id>report</id>
              <phase>verify</phase>
              <goals><goal>report</goal></goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.pitest</groupId>
          <artifactId>pitest-maven</artifactId>
          <version>${pitest.version}</version>
          <configuration>
            <skip>${pitest.skip}</skip>
            <mutationThreshold>80</mutationThreshold>
          </configuration>
          <dependencies>
            <dependency>
              <groupId>org.pitest</groupId>
              <artifactId>pitest-junit5-plugin</artifactId>
              <version>${pitest-junit5.version}</version>
            </dependency>
          </dependencies>
        </plugin>
        <plugin>
          <groupId>org.owasp</groupId>
          <artifactId>dependency-check-maven</artifactId>
          <version>${dependency-check.version}</version>
          <configuration>
            <skip>${dependency-check.skip}</skip>
            <failBuildOnCVSS>7</failBuildOnCVSS>
            <suppressionFile>dependency-check-suppressions.xml</suppressionFile>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${enforcer.version}</version>
          <executions>
            <execution>
              <id>enforce</id>
              <phase>validate</phase>
              <goals><goal>enforce</goal></goals>
              <configuration>
                <rules>
                  <requireJavaVersion><version>[25,26)</version></requireJavaVersion>
                  <requireMavenVersion><version>[3.9,)</version></requireMavenVersion>
                  <banDuplicatePomDependencyVersions/>
                </rules>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>versions-maven-plugin</artifactId>
          <version>${versions.version}</version>
        </plugin>
        <plugin>
          <groupId>org.flywaydb</groupId>
          <artifactId>flyway-maven-plugin</artifactId>
          <version>${flyway.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${failsafe.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- 100% coverage + 80% PITest gate: auto-activated in modules
         containing the src/main/java/.domain marker file (create it empty in
         the domain module). Alternative: declare both plugins in the module's pom. -->
    <profile>
      <id>domain-gate</id>
      <activation>
        <file><exists>src/main/java/.domain</exists></file>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>check</id>
                <phase>verify</phase>
                <goals><goal>check</goal></goals>
                <configuration>
                  <rules>
                    <rule>
                      <element>BUNDLE</element>
                      <limits>
                        <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>1.00</minimum></limit>
                        <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>1.00</minimum></limit>
                      </limits>
                    </rule>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
            <executions>
              <execution>
                <id>mutation</id>
                <phase>verify</phase>
                <goals><goal>mutationCoverage</goal></goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- Fast build: skips only PITest and dependency-check; tests still run. -->
    <profile>
      <id>fast</id>
      <properties>
        <pitest.skip>true</pitest.skip>
        <dependency-check.skip>true</dependency-check.skip>
      </properties>
    </profile>

    <!-- Release: forbids SNAPSHOT dependencies. -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <executions>
              <execution>
                <id>enforce-release</id>
                <phase>validate</phase>
                <goals><goal>enforce</goal></goals>
                <configuration>
                  <rules>
                    <requireReleaseDeps><message>No SNAPSHOTs in a release</message></requireReleaseDeps>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
